generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

enum GalleryCategory {
  DAILY_LIFE_GROWTH
  COMMUNITY_FELLOWSHIP
  LEARNING_CREATIVITY
  EVENTS_MILESTONES
  OTHERS
  EDUCATION
  HEALTH
  FOOD
  GUIDANCE
  SHELTER
  SKILLS
  EVENTS
  OTHER
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

model ContactSubmission {
  id        String           @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
}

model VolunteerSubmission {
  id             String           @id @default(uuid())
  name           String
  email          String
  phone          String?
  location       String?
  interests      String?
  availability   String?
  experience     String?
  message        String?
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String?
  status       SubmissionStatus @default(NEW)
  subscribedAt DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, subscribedAt])
}

model SponsorSubmission {
  id                String           @id @default(uuid())
  name              String
  email             String
  phone             String?
  location          String?
  preferredContact  String?
  message           String?
  status            SubmissionStatus @default(NEW)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, createdAt])
}

model EmailNotificationLog {
  id           String   @id @default(uuid())
  type         String
  recipient    String
  subject      String
  resendId     String?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
}

model SiteSettings {
  id          Int      @id @default(1)
  siteName    String   @default("Glory Children Ministry")
  tagline     String   @default("Hope, Education & Opportunity")
  email       String   @default("info@glorychildrenministry.org")
  phone1      String?
  phone2      String?
  location    String?
  whatsapp    String?
  instagram   String?
  facebook    String?
  threads     String?
  tiktok      String?
  youtube     String?
  updatedAt   DateTime @updatedAt
}

model DonationMethod {
  id            String   @id @default(uuid())
  name          String
  accountName   String?
  accountNumber String?
  instructions String?
  logoUrl       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ImpactStatistic {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  value       String
  description String?
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Cause {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  imageUrl    String?
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model MediaAsset {
  id          String   @id @default(uuid())
  key         String   @unique
  page        String
  title       String?
  altText     String?
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([page])
}

model GalleryItem {
  id          String          @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  category    GalleryCategory @default(OTHER)
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, isPublished, sortOrder])
}

model NewsArticle {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
